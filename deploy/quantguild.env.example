# Copy to /etc/quantguild.env on the VM, fill in, then:
#   sudo chown root:quantguild /etc/quantguild.env
#   sudo chmod 640 /etc/quantguild.env
#
# This file holds the only real secrets in the deployment. It lives outside
# /var/www/html on purpose, anything in the repo is one `git push` away from
# being on the public internet.

# --- Google OAuth ---------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URI must match QG_OAUTH_REDIRECT_URI below exactly.
QG_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
QG_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- identity -------------------------------------------------------------
QG_ALLOWED_DOMAIN=smail.iitm.ac.in
QG_ADMIN_EMAILS=quant.guild@smail.iitm.ac.in

# --- URLs -----------------------------------------------------------------
# Set to https://... once certbot has run, so session cookies get the Secure flag.
QG_PUBLIC_ORIGIN=https://quantguildiitm.in
QG_OAUTH_REDIRECT_URI=https://quantguildiitm.in/api/auth/callback

# --- limits ---------------------------------------------------------------
QG_MAX_UPLOAD_BYTES=524288
QG_SESSION_TTL=43200

# Force a sandbox tier instead of auto-detecting (docker|bwrap|unshare|sudo|plain).
# Leave unset unless you are debugging.
# QG_SANDBOX_TIER=bwrap
